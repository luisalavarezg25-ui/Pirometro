 "ajuste_iluminacion": {
  "descripcion": "Corrección a sumar a la temperatura estimada por apariencia/tono según la luz ambiente. Con más luz el brillo propio se ve menos y el acero está más caliente de lo que parece. Referencia: taller en penumbra. Basado en el umbral de visibilidad: 399 °C en oscuridad y 482 °C con luz diurna (US Navy, Machinery Repairman); 400/474/525/581 °C en oscuridad/crepúsculo/día/sol (Hearth.com). El efecto se reduce a la mitad por encima de ~800 °C.",
  "valores_C": {
   "oscuridad": -50,
   "penumbra": 0,
   "interior_iluminado": 50,
   "luz_diurna": 75,
   "sol_directo": 125
  },
  "factor_por_encima_800C": 0.5
 },
 "solucion_comun": {
  "descripcion": "Fusión de tres estimadores independientes, ponderados por la inversa de su varianza: T = Σ(T_i/σ_i²)/Σ(1/σ_i²).",
  "estimadores": [
   {
    "id": "tono_banda",
    "metodo": "Banda de 'incandescencia' más cercana por H y V de píxeles no saturados + fracción saturada, con ajuste_iluminacion",
    "sigma_C": 75
   },
   {
    "id": "relacion_G_R",
    "metodo": "JPEG: invertir srgb_lineal_G_R sobre píxeles con R<0,9 lineal y T>650 °C; RAW: invertir camera_model_G_R calibrado. Excluir si no hay píxeles válidos.",
    "sigma_C_sin_calibrar": 150,
    "sigma_C_calibrado": 40
   },
   {
    "id": "brillo_absoluto",
    "metodo": "Solo con exposición/ISO bloqueados y calibrados: invertir camera_model_R_rel_1000C; muy sensible a emisividad",
    "sigma_C": 60,
    "solo_version_movil": true
   }
  ],
  "reglas": [
   "Si >30 % de la zona está saturada, subir el peso de tono_banda y avisar 'baja la exposición'.",
